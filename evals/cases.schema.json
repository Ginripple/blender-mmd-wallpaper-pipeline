{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cases.schema.json",
  "title": "Blender MMD Wallpaper Pipeline Agent Eval Cases",
  "type": "object",
  "required": [
    "schema_version",
    "result_contract",
    "assertion_contract",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "result_contract": {
      "const": {
        "skill_selected": "boolean",
        "phase": "integer|null",
        "behaviors": "array<string>",
        "actions": "array<string>",
        "tool_calls": "array<string>"
      }
    },
    "assertion_contract": {
      "const": {
        "fields": [
          "skill_selected",
          "phase",
          "behaviors",
          "actions",
          "tool_calls"
        ],
        "operators": [
          "eq",
          "contains",
          "not_contains"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "id",
        "prompt",
        "assertions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      }
    },
    "assertion": {
      "oneOf": [
        {
          "$ref": "#/$defs/skillSelectedAssertion"
        },
        {
          "$ref": "#/$defs/phaseAssertion"
        },
        {
          "$ref": "#/$defs/arrayMembershipAssertion"
        }
      ]
    },
    "skillSelectedAssertion": {
      "type": "object",
      "required": [
        "field",
        "operator",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "const": "skill_selected"
        },
        "operator": {
          "const": "eq"
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    "phaseAssertion": {
      "type": "object",
      "required": [
        "field",
        "operator",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "const": "phase"
        },
        "operator": {
          "const": "eq"
        },
        "value": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "arrayMembershipAssertion": {
      "type": "object",
      "required": [
        "field",
        "operator",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "behaviors",
            "actions",
            "tool_calls"
          ]
        },
        "operator": {
          "enum": [
            "contains",
            "not_contains"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
